# The Python "lib/" ignore above (packaging boilerplate) was swallowing the
# backend's core TypeScript library at backend/lib/. It is NOT a build dir —
# it holds the Db interface, storage adapters, DTOs, schemas and tests.
# Keep it tracked; re-ignore only its build artifacts.
!backend/lib/
!backend/lib/**
backend/lib/dist/
backend/lib/node_modules/
backend/lib/**/*.tsbuildinfo

# Lambda build output (scripts/build-lambdas.sh) — reproducible, never tracked.
backend/dist-lambdas/
backend/lambdas/ticket-extractor/.build/
backend/lambdas/ticket-extractor/.venv-build/
*.egg
MANIFEST


# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

