{
  "name": "@railback/db",
  "version": "0.1.0",
  "description": "DynamoDB connector layer for RailBack",
  "main": "dist/connector.js",
  "types": "dist/connector.d.ts",
  "exports": {
    ".": {
      "import": "./dist/connector.js",
      "types": "./dist/connector.d.ts"
    },
    "./adapter": {
      "import": "./dist/adapter.js",
      "types": "./dist/adapter.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./dtos": {
      "import": "./dist/dtos/index.js",
      "types": "./dist/dtos/index.d.ts"
    },
    "./dtos/dto": {
      "import": "./dist/dtos/dto.js",
      "types": "./dist/dtos/dto.d.ts"
    },
    "./dtos/enums": {
      "import": "./dist/dtos/enums.js",
      "types": "./dist/dtos/enums.d.ts"
    },
    "./dtos/items": {
      "import": "./dist/dtos/items.js",
      "types": "./dist/dtos/items.d.ts"
    }
  },
  "scripts": {
    "prepare": "tsc || true",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:integration": "RAILBACK_RUN_INTEGRATION=1 node --experimental-vm-modules node_modules/.bin/jest tests/integration.test.ts"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/scripts/jest-global-setup.mjs",
    "maxWorkers": 1,
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/credential-providers": "^3.1080.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.1080.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
